# Workers Static Assets: gilt für alle ausgelieferten Dateien (kein Worker-Skript nötig).
# Strenge CSP ohne Inline-Code, keine Drittquellen. noindex in Meta UND Header, solange Impressum/Datenschutz Platzhalter sind.
/*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Dateien mit Inhalts-Hash im Namen
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Release-Daten: kurz zwischenspeichern, der App-Updater liest latest.json
/release.json
  Cache-Control: public, max-age=60, must-revalidate
/releases/latest.json
  Cache-Control: public, max-age=60, must-revalidate
/releases/*
  Cache-Control: public, max-age=3600
/catalog/v1/*
  Cache-Control: public, max-age=300, must-revalidate
