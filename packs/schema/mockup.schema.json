{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio.cypherxcypher.de/schemas/mockup.schema.json",
  "title": "Mockup-Vorlage (packs/mockups/<id>/template.json)",
  "description": "ARCHITEKTUR.md 4.8, Typ MockupTemplate im IPC-Vertrag, aber mit Dateinamen statt AssetUrl. Das Schema liefert Team C1, die Inhalte (Bilder, template.json) liefert Team C2. Zusatz gegenüber dem Vertrag: formatVersion (optional).",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "type": "integer", "const": 1 },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "$ref": "common.schema.json#/$defs/label" },
    "product": { "type": "string", "enum": ["tee", "hoodie"] },
    "view": { "type": "string", "enum": ["front", "back"] },
    "canvas": { "$ref": "common.schema.json#/$defs/size" },
    "printProfileId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "printArea": {
      "type": "object",
      "properties": {
        "quad": {
          "description": "Oben links, oben rechts, unten rechts, unten links (Pixel der Vorlage).",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "common.schema.json#/$defs/point" }
        }
      },
      "required": ["quad"],
      "additionalProperties": false
    },
    "displaceStrengthPx": { "type": "number", "minimum": 0 },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "exposure": { "type": "string", "enum": ["light", "dark"] },
          "layers": {
            "type": "object",
            "properties": {
              "mask": { "$ref": "common.schema.json#/$defs/relPath" },
              "shade": { "$ref": "common.schema.json#/$defs/relPath" },
              "light": { "$ref": "common.schema.json#/$defs/relPath" },
              "displace": { "oneOf": [{ "$ref": "common.schema.json#/$defs/relPath" }, { "type": "null" }] },
              "texture": { "oneOf": [{ "$ref": "common.schema.json#/$defs/relPath" }, { "type": "null" }] },
              "heather": { "oneOf": [{ "$ref": "common.schema.json#/$defs/relPath" }, { "type": "null" }] },
              "background": { "oneOf": [{ "$ref": "common.schema.json#/$defs/relPath" }, { "type": "null" }] }
            },
            "required": ["mask", "shade", "light", "displace", "texture", "heather", "background"],
            "additionalProperties": false
          },
          "colorIds": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true }
        },
        "required": ["exposure", "layers", "colorIds"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "title", "product", "view", "canvas", "printProfileId", "printArea", "displaceStrengthPx", "variants"],
  "additionalProperties": false
}
