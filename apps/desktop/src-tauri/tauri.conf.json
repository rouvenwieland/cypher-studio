{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cypher Studio",
  "mainBinaryName": "cypher-studio",
  "version": "0.1.0",
  "identifier": "de.cypherxcypher.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Cypher Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: blob: cyfile: cythumb: cyasset: http://cyfile.localhost http://cythumb.localhost http://cyasset.localhost",
        "font-src": "'self' cyasset: http://cyasset.localhost",
        "connect-src": "ipc: http://ipc.localhost cyfile: cyasset: http://cyfile.localhost http://cyasset.localhost",
        "worker-src": "'self' blob:",
        "media-src": "'self' cyfile: http://cyfile.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'none'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: cyfile: cythumb: cyasset: http://cyfile.localhost http://cythumb.localhost http://cyasset.localhost http://localhost:1420",
        "font-src": "'self' cyasset: http://cyasset.localhost http://localhost:1420",
        "connect-src": "ipc: http://ipc.localhost cyfile: cyasset: http://cyfile.localhost http://cyasset.localhost ws://localhost:1420 http://localhost:1420",
        "worker-src": "'self' blob:",
        "media-src": "'self' cyfile: http://cyfile.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "assetProtocol": { "enable": false },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "Cypher Kollektiv",
    "copyright": "Cypher Kollektiv, MIT-Lizenz",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "../../../packs/dist/": "packs/" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "appimage": { "bundleMediaFramework": false }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxNkNFRDAzNzFCODM4NTgKUldSWU9MaHhBKzFzY1VuMERVOXRMR0ZEZHZwWkJGelhrcWVyV0NjZktIZGExc1FacmlWWjJXcnAK",
      "endpoints": [
        "https://studio.cypherxcypher.de/releases/latest.json",
        "https://github.com/cypher-kollektiv/cypher-studio/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" },
      "requireSignedVersion": true
    }
  }
}
